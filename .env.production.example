# AgriConnect Frontend Environment Configuration (Production)

# Production Map Tile Server CDN & Attribution
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Production Nominatim & OSRM Endpoints
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Production User Agent (Must include contact email per Nominatim Usage Policy)
VITE_NOMINATIM_USER_AGENT=AgriConnect-Platform-Prod/1.0 (admin@agriconnect.com)

# Production Cache TTLs (Seconds)
VITE_GEOCODING_CACHE_TTL=86400
VITE_ROUTE_CACHE_TTL=604800

# Radial Search Boundaries
VITE_MAX_SEARCH_RADIUS_KM=100
VITE_DEFAULT_SEARCH_RADIUS_KM=25

# Default Center & Privacy Settings
VITE_MAP_DEFAULT_LAT=31.634
VITE_MAP_DEFAULT_LNG=75.8573
VITE_MAP_DEFAULT_ZOOM=12
VITE_LOCATION_PRIVACY_DEFAULT=approximate
