# AgriConnect Backend Configuration (Development Blueprint)

NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect_db

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173


GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Security & JWT Token Configuration
JWT_ACCESS_SECRET=your_dev_access_token_secret_key_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_dev_refresh_token_secret_key_32bytes_min
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_dev_cookie_signing_secret_32bytes_min

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=AgriConnect Platform <no-reply@agriconnect.com>

# Groq / OpenAI LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1


# Location & GIS Configuration
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgriConnect-Platform/1.0 (contact@agriconnect.com)
NOMINATIM_TIMEOUT_MS=5000
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_CACHE_TTL=3600
ROUTE_CACHE_TTL=86400
MAX_SEARCH_RADIUS_KM=100
DEFAULT_SEARCH_RADIUS_KM=25
LOCATION_PRIVACY_DEFAULT=approximate

# Razorpay Payments & Subscriptions
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=development
PAYMENT_CURRENCY=INR
PREMIUM_MONTHLY_PLAN_ID=farmer_pro_monthly
PREMIUM_YEARLY_PLAN_ID=farmer_pro_yearly

# Telephony Voice Calling Provider (Twilio / Telecom Carrier)
CALL_PROVIDER=twilio
CALL_PROVIDER_MODE=real
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

