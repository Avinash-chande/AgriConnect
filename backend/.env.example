# AgriConnect Backend Configuration Example

NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect_db

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=AgriConnect Platform <no-reply@agriconnect.com>

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Groq AI Module Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Open-Source Location & GIS Module Configuration ────────────────────────
# OpenStreetMap Tile Server URL Template
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim Open-Source Geocoding API Base URL
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Custom User-Agent for Nominatim (required by Nominatim Usage Policy)
NOMINATIM_USER_AGENT=AgriConnect-Platform/1.0 (contact@agriconnect.com)

# HTTP Request Timeout for Geocoding (milliseconds)
NOMINATIM_TIMEOUT_MS=5000

# OSRM Free Open-Source Routing Engine Base URL
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding In-Memory Cache TTL (seconds)
GEOCODING_CACHE_TTL=3600

# Route Polyline Calculation Cache TTL (seconds)
ROUTE_CACHE_TTL=86400

# Maximum Permissible Search Radius (Kilometers)
MAX_SEARCH_RADIUS_KM=100

# Default Search Radius for Discovery Maps (Kilometers)
DEFAULT_SEARCH_RADIUS_KM=25

# Location Privacy Default Level ('private' | 'approximate' | 'verified_users' | 'public')
LOCATION_PRIVACY_DEFAULT=approximate
