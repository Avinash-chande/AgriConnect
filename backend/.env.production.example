# AgriConnect Backend Configuration (Production Blueprint)

NODE_ENV=production
PORT=5000

# Production MongoDB Connection URI (SSL/TLS Required)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<db_cluster>.mongodb.net/agriconnect_prod?retryWrites=true&w=majority

# Production Allowed Origins (Exact origin required for CORS credentials security)
CORS_ORIGIN=https://agriconnect.com

# Production JWT & Cookie Secrets (High-entropy secret keys required)
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=REPLACE_WITH_SECURE_64_CHAR_HEX_KEY

# Strict Production Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=production_cloud_name
CLOUDINARY_API_KEY=production_api_key
CLOUDINARY_API_SECRET=production_api_secret

# Production SMTP Email Delivery Credentials
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=production_smtp_api_key
EMAIL_FROM=AgriConnect Platform <no-reply@agriconnect.com>

# Production Groq / OpenAI LLM Credentials
GROQ_API_KEY=gsk_production_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# GIS & OpenStreetMap Production Settings
OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgriConnect-Platform-Prod/1.0 (contact@agriconnect.com)
NOMINATIM_TIMEOUT_MS=5000
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_CACHE_TTL=86400
ROUTE_CACHE_TTL=604800
MAX_SEARCH_RADIUS_KM=100
DEFAULT_SEARCH_RADIUS_KM=25
LOCATION_PRIVACY_DEFAULT=approximate

# Razorpay Production Payment & Webhook Configuration
RAZORPAY_KEY_ID=rzp_live_production_key_id
RAZORPAY_KEY_SECRET=production_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=production_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=production
PAYMENT_CURRENCY=INR
PREMIUM_MONTHLY_PLAN_ID=plan_monthly_live_id
PREMIUM_YEARLY_PLAN_ID=plan_yearly_live_id
