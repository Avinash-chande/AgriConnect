# AgriConnect Backend Configuration (Test Blueprint)

NODE_ENV=test
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect_test_db
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/agriconnect_test_db

CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=test_jwt_access_secret_key_32bytes_min_required
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_32bytes_min_required
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=test_cookie_secret_key_32bytes_min_required

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

CLOUDINARY_CLOUD_NAME=test_cloud
CLOUDINARY_API_KEY=test_key
CLOUDINARY_API_SECRET=test_secret

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM=AgriConnect Test <no-reply@agriconnect.com>

GROQ_API_KEY=test_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgriConnect-Platform-Test/1.0
NOMINATIM_TIMEOUT_MS=5000
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_CACHE_TTL=60
ROUTE_CACHE_TTL=60
MAX_SEARCH_RADIUS_KM=100
DEFAULT_SEARCH_RADIUS_KM=25
LOCATION_PRIVACY_DEFAULT=approximate

RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=test_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret
RAZORPAY_ENVIRONMENT=test
PAYMENT_CURRENCY=INR
PREMIUM_MONTHLY_PLAN_ID=farmer_pro_monthly
PREMIUM_YEARLY_PLAN_ID=farmer_pro_yearly
