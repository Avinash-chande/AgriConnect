        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Gurpreet Singh\",\n  \"email\": \"gurpreet.farmer@agriconnect.com\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"FarmerPass123!\",\n  \"farmName\": \"Green Acres Organic Estate\",\n  \"farmType\": \"Grain & Wheat Cultivation\",\n  \"location\": \"Amritsar, Punjab\",\n  \"totalAcreage\": 45,\n  \"farmDescription\": \"Commercial wheat and sugarcane estate producing certified organic grains.\"\n}"
