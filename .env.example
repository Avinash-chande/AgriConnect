# AgriConnect Frontend Environment Configuration Example (Development)

# OpenStreetMap Tile Server URL Template
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Nominatim Geocoding API Base URL
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# OSRM Free Open-Source Routing Engine Base URL
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Custom User-Agent for Nominatim requests
VITE_NOMINATIM_USER_AGENT=AgriConnect-Platform/1.0 (contact@agriconnect.com)

# Cache TTL Configurations (seconds)
VITE_GEOCODING_CACHE_TTL=3600
VITE_ROUTE_CACHE_TTL=86400

# Radial Search Limits (Kilometers)
VITE_MAX_SEARCH_RADIUS_KM=100
VITE_DEFAULT_SEARCH_RADIUS_KM=25

# Default Map Center (Amritsar, Punjab) & Zoom Level
VITE_MAP_DEFAULT_LAT=31.634
VITE_MAP_DEFAULT_LNG=75.8573
VITE_MAP_DEFAULT_ZOOM=12

# Location Privacy Default ('private' | 'approximate' | 'verified_users' | 'public')
VITE_LOCATION_PRIVACY_DEFAULT=approximate
